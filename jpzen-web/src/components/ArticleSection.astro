---
const { section, index } = Astro.props;
---

<section class="border-t border-cyan-300/15 py-8">
  <p class="font-mono text-xs text-cyan-300">0{index + 1}</p>
  <h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] text-white md:text-3xl">{section.title}</h2>
  <p class="mt-4 max-w-2xl text-base leading-7 text-slate-300">{section.body}</p>
</section>
