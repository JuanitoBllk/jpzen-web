---
const { title = 'Connected cores', description, links = [] } = Astro.props;
---

<section class="mx-auto max-w-6xl px-6">
  <div class="grid gap-8 border-t border-cyan-300/15 pt-8 md:grid-cols-[0.7fr_1.3fr] md:pt-10">
    <div>
      <p class="font-mono text-xs tracking-[0.18em] text-cyan-300">CORE CONNECTIONS</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-[-0.04em] text-white md:text-4xl">{title}</h2>
    </div>
    <p class="max-w-2xl text-base leading-7 text-slate-400">{description}</p>
  </div>

  <div class="mt-10 grid gap-5 sm:grid-cols-2">
    {links.map((link) => (
      <a href={link.href} class="group border-l border-cyan-300/30 pl-5 transition hover:border-cyan-300">
        <p class="font-mono text-xs tracking-[0.14em] text-cyan-300">{link.label}</p>
        <h3 class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-white transition group-hover:text-cyan-300">{link.name}</h3>
        <p class="mt-3 max-w-sm text-sm leading-6 text-slate-400">{link.description}</p>
      </a>
    ))}
  </div>
</section>
