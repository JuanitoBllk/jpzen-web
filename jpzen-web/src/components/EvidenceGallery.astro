---
const { evidence = [] } = Astro.props;
---

{evidence.length > 0 && (
  <section class="mx-auto mt-24 max-w-6xl px-6 md:mt-32">
    <div class="grid gap-8 border-t border-cyan-300/15 pt-8 md:grid-cols-[0.7fr_1.3fr] md:pt-10">
      <div>
        <p class="font-mono text-xs tracking-[0.18em] text-cyan-300">EVIDENCE</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-0.04em] text-white md:text-4xl">Visual record.</h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {evidence.map((item, index) => (
          <article class="border border-cyan-300/20 bg-slate-950/45">
            {item.image ? (
              <img src={item.image} alt={item.title} class="aspect-[16/9] w-full object-cover" loading="lazy" />
            ) : (
              <div class="flex aspect-[16/9] items-end border-b border-cyan-300/15 bg-[radial-gradient(circle_at_center,_rgba(0,229,255,0.12),_transparent_65%)] p-5">
                <p class="font-mono text-xs tracking-[0.16em] text-cyan-300/70">EVIDENCE / 0{index + 1}</p>
              </div>
            )}
            <div class="p-5">
              <p class="font-mono text-xs tracking-[0.14em] text-cyan-300">{item.type}</p>
              <h3 class="mt-3 text-lg font-semibold text-white">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-400">{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
