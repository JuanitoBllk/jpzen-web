---
import CosmicField from './CosmicField.astro';
import SystemPanel from './SystemPanel.astro';
---
<section id="top" class="relative isolate overflow-hidden px-6 pb-24 pt-32 md:pb-32 md:pt-40">
  <CosmicField />

  <div class="relative z-10 mx-auto grid max-w-6xl items-center gap-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12">
    <div class="max-w-2xl">
      <p class="font-mono text-xs tracking-[0.2em] text-cyan-300">
        JPZEN / PERSONAL TECHNOLOGY LABORATORY
      </p>

      <h1 class="mt-7 text-5xl font-semibold leading-[0.95] tracking-[-0.05em] text-white sm:text-6xl md:text-7xl">
        CURIOUS BY NATURE.
        <span class="block text-cyan-300">BUILDING THROUGH EXPERIMENTATION.</span>
      </h1>

      <p class="mt-8 max-w-xl text-base leading-7 text-slate-300 md:text-lg">
        A personal technology laboratory documenting experiments, systems, learning, and engineering progress across infrastructure, artificial intelligence, automation, and networking.
      </p>

      <div class="mt-9 flex flex-col items-start gap-5 sm:flex-row sm:items-center">
        <a href="#projects" class="inline-flex items-center justify-center border border-cyan-300 bg-cyan-300 px-6 py-3 text-sm font-semibold tracking-[0.08em] text-slate-950 transition hover:bg-white">
          EXPLORE THE LABORATORY
        </a>
        <p class="font-mono text-xs tracking-[0.08em] text-slate-400">
          PUBLIC DOCUMENTATION. PRIVATE INFRASTRUCTURE.
        </p>
      </div>
    </div>

    <div class="relative mx-auto flex min-h-72 w-full max-w-md items-center justify-center lg:min-h-96 lg:justify-self-end">
      <img src="/jpzen.svg" alt="JPZEN orbital mark" width="208" height="208" fetchpriority="high" class="relative z-10 w-44 drop-shadow-[0_0_36px_rgba(0,229,255,0.26)] sm:w-52" />
    </div>
  </div>

  <div class="relative z-10 mx-auto mt-16 max-w-6xl md:mt-20">
    <SystemPanel />
  </div>
</section>
