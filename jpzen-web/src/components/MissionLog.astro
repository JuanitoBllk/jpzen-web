---
import { fieldLogEntries } from '../data/log.js';

const {
  id = 'missions',
  label = 'FIELD NOTES',
  title = 'The laboratory is built in chapters.',
  summary = 'A concise record of implemented work and the next deliberate direction. Planned work remains clearly marked until it becomes real.',
  entries = fieldLogEntries
} = Astro.props;
---

<section id={id} class="field-notes mx-auto mt-28 max-w-6xl px-6 md:mt-32">
  <div class="field-notes-header grid gap-8 border-t border-cyan-300/15 pt-8 md:grid-cols-[0.7fr_1.3fr] md:pt-10">
    <div>
      <p class="font-mono text-xs tracking-[0.18em] text-cyan-300">{label}</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-[-0.04em] text-white md:text-4xl">{title}</h2>
    </div>
    <p class="max-w-2xl text-base leading-7 text-slate-400">{summary}</p>
  </div>

  <ol class="field-notes-list mt-10 border-l border-cyan-300/20">
    {entries.map((entry, index) => (
      <li class:list={['field-note', { 'is-planned': entry.status === 'PLANNED' }, 'grid gap-4 py-6 pl-6 md:grid-cols-[8rem_1fr_auto] md:items-start md:gap-8', { 'border-b border-cyan-300/10': index < entries.length - 1 }]}>
        <p class:list={['font-mono text-xs', entry.status === 'PLANNED' ? 'text-slate-500' : 'text-cyan-300']}>{entry.date}</p>
        <div>
          <h3 class="text-xl font-semibold text-white">{entry.title}</h3>
          <p class="mt-2 max-w-xl text-sm leading-6 text-slate-400">{entry.description}</p>
        </div>
        <p class="font-mono text-xs tracking-[0.1em] text-slate-500">{entry.status}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .field-notes {
    position: relative;
  }

  .field-notes-header {
    position: relative;
  }

  .field-notes-header::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(40%, 22rem);
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(0, 229, 255, 0.4), transparent);
  }

  .field-notes-list {
    position: relative;
    background: linear-gradient(90deg, rgba(0, 229, 255, 0.025), transparent 42%);
  }

  .field-note {
    position: relative;
  }

  .field-note::before {
    content: "";
    position: absolute;
    top: 2rem;
    left: -5px;
    width: 9px;
    height: 9px;
    border: 1px solid rgba(0, 229, 255, 0.72);
    border-radius: 50%;
    background: #05070d;
    box-shadow: 0 0 0 5px rgba(5, 7, 13, 0.9);
  }

  .field-note.is-planned::before {
    border-style: dashed;
    opacity: 0.7;
  }
</style>
