---
const { project, index } = Astro.props;
---

<article class="group flex h-full flex-col border-t border-cyan-300/15 pt-5 transition hover:border-cyan-300/50">
  <div class="flex items-start justify-between gap-4">
    <p class="font-mono text-xs text-cyan-300">0{index + 1}</p>
    <p class="font-mono text-xs tracking-[0.1em] text-slate-500">{project.status}</p>
  </div>
  <p class="mt-5 font-mono text-xs tracking-[0.12em] text-cyan-300">{project.core} / {project.category}</p>
  <h2 class="mt-3 text-2xl font-semibold tracking-[-0.03em] text-white transition group-hover:text-cyan-300">{project.title}</h2>
  <p class="mt-4 text-sm leading-6 text-slate-400">{project.description}</p>
  <div class="mt-6 flex flex-wrap gap-2">
    {project.technologies.map((technology) => <span class="border border-cyan-300/15 px-2 py-1 font-mono text-[10px] tracking-[0.08em] text-slate-400">{technology}</span>)}
  </div>
  <a href={project.route} class="mt-8 inline-flex font-mono text-xs tracking-[0.12em] text-cyan-300 transition hover:text-white">VIEW DOCUMENTATION</a>
</article>
