---
import CosmicField from './CosmicField.astro';

const { project } = Astro.props;
---

<section id="top" class="relative isolate overflow-hidden px-6 pb-20 pt-32 md:pb-28 md:pt-40">
  <CosmicField />

  <div class="relative z-10 mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
    <div>
      <p class="font-mono text-xs tracking-[0.2em] text-cyan-300">JPZEN / PROJECT RECORD</p>
      <h1 class="mt-6 max-w-3xl text-5xl font-semibold tracking-[-0.06em] text-white sm:text-6xl md:text-7xl">{project.title}</h1>
      <p class="mt-5 font-mono text-xs tracking-[0.14em] text-cyan-200">{project.core} / {project.category}</p>
      <p class="mt-8 max-w-xl text-base leading-7 text-slate-300 md:text-lg">{project.description}</p>
    </div>

    <div class="border-l border-cyan-300/40 pl-6 md:pl-8 lg:mb-2">
      <p class="font-mono text-xs tracking-[0.16em] text-slate-500">STATUS</p>
      <p class="mt-3 font-mono text-sm tracking-[0.1em] text-cyan-300">{project.status}</p>
    </div>
  </div>
</section>
