---
import ProjectCard from './ProjectCard.astro';
---

<section id="projects" class="mt-24 max-w-5xl mx-auto px-6">

  <h2 class="text-3xl tracking-widest text-center mb-12">
    PROJECTS
  </h2>


  <div class="grid md:grid-cols-3 gap-6">


    <ProjectCard
      name="ATLAS"
      category="Infrastructure Core"
      description="The foundation layer where systems are built, tested and maintained."
      systems={[
        "Proxmox VE",
        "Linux Containers",
        "Docker Runtime",
        "Self-hosted Services"
      ]}
      status="● OPERATIONAL"
    />



    <ProjectCard
      name="NOVA"
      category="AI & Automation Core"
      description="Exploring intelligent systems, agents and automation workflows."
      systems={[
        "OpenClaw",
        "AI Agents",
        "Automation Workflows",
        "Experimental Systems"
      ]}
      status="● OPERATIONAL"
    />



    <ProjectCard
      name="ORION"
      category="Network & Connectivity Core"
      description="Designing a smarter and more secure connectivity environment."
      systems={[
        "DNS Architecture",
        "VLAN Segmentation",
        "Firewall Layer",
        "Wireless Infrastructure"
      ]}
      status="○ DEVELOPMENT"
    />


  </div>

</section>