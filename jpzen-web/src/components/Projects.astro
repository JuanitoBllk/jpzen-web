---
import ProjectCard from './ProjectCard.astro';
import { systems } from '../data/system.js';
---

<section id="projects" class="mt-24 max-w-5xl mx-auto px-6">

  <h2 class="text-3xl tracking-widest text-center mb-12">
    PROJECTS
  </h2>


  <div class="grid md:grid-cols-3 gap-6">


    {
      systems.map((system) => (

<ProjectCard
 name={system.name}
 category={system.category}
 description={system.description}
 systems={system.systems}
 status={system.status}
 details={system.details}
/>

      ))
    }


  </div>

</section>