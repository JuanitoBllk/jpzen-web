---
const { system, index } = Astro.props;
---

<article class="group border-t border-cyan-300/15 pt-5 transition hover:border-cyan-300/50">
  <p class="font-mono text-xs text-cyan-300">0{index + 1}</p>
  <h3 class="mt-5 text-2xl font-semibold tracking-[-0.03em] text-white transition group-hover:text-cyan-300">{system.name}</h3>
  <p class="mt-2 font-mono text-xs tracking-[0.1em] text-slate-500">{system.role}</p>
  <p class="mt-5 max-w-sm text-sm leading-6 text-slate-400">{system.description}</p>
</article>
