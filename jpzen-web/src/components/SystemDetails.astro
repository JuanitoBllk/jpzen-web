---
const {
  details
} = Astro.props;
---


<div class="mt-6 border-t border-cyan-400/10 pt-5">


<p class="text-xs tracking-widest text-gray-500 mb-4">
SYSTEM DETAILS
</p>


<div class="space-y-3 text-sm text-gray-300">


{Object.entries(details).map(([key,value]) => (

<div>

<span class="text-cyan-400 uppercase">
{key}
</span>


<p class="mt-1 text-gray-400">

{
Array.isArray(value)
?
value.map(item => (
<div>
● {item}
</div>
))
:
value
}

</p>


</div>

))}


</div>


</div>