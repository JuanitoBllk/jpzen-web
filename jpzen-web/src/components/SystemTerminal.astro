---
const {
  system
} = Astro.props;
---


<section class="mt-24 max-w-5xl mx-auto px-6">


<div class="border border-cyan-400/30 rounded-xl bg-black/40 p-8">


<div class="text-cyan-400 tracking-[0.5em] text-sm mb-8">

SYSTEM TERMINAL

</div>



<h2 class="text-4xl font-bold tracking-widest">

{system.name}

</h2>



<p class="text-cyan-300 mt-2">

{system.category}

</p>



<div class="mt-8 space-y-6 font-mono text-sm">


{
Object.entries(system.details).map(([key,value]) => (

<div>


<div class="text-cyan-400 uppercase">

{key}

</div>


<div class="text-gray-400 mt-2">


{
Array.isArray(value)
?
value.map(item => (
<div>
> {item}
</div>
))
:
<div>
> {value}
</div>
}


</div>


</div>

))
}


</div>


</div>


</section>