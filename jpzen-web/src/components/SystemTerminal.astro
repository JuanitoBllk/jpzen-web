---
const {
  system,
  index
} = Astro.props;
---

{system.id === 'atlas' && (
  <section id={system.id} class="core-profile core-atlas mx-auto mt-24 max-w-6xl px-6 md:mt-28">
    <div class="core-atlas-frame grid gap-10 border-t border-cyan-300/30 pt-8 lg:grid-cols-[0.8fr_1.2fr] lg:pt-12">
      <div>
        <p class="font-mono text-xs tracking-[0.18em] text-cyan-300">0{index + 1} / {system.status}</p>
        <h2 class="mt-5 text-5xl font-semibold tracking-[-0.05em] text-white md:text-6xl">{system.name}</h2>
        <p class="mt-3 text-sm text-slate-500">{system.category}</p>
      </div>
      <div>
        <p class="max-w-xl text-xl leading-8 text-slate-200">{system.description}</p>
        <div class="atlas-capabilities mt-10 grid gap-px bg-cyan-300/15 sm:grid-cols-3">
          {system.systems.slice(0, 3).map((capability) => <p class="bg-[#05070d] px-5 py-5 text-sm leading-6 text-slate-300">{capability}</p>)}
        </div>
        <div class="mt-8 border-l border-cyan-300 pl-5">
          <p class="font-mono text-xs tracking-[0.15em] text-cyan-300">{system.focusLabel}</p>
          <p class="mt-3 max-w-xl text-base leading-7 text-slate-400">{system.focus}</p>
        </div>
      </div>
    </div>
  </section>
)}

{system.id === 'nova' && (
  <section id={system.id} class="core-profile core-nova mx-auto mt-24 max-w-6xl px-6 md:mt-28">
    <div class="nova-study grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
      <div class="border-l border-cyan-300/50 pl-6 md:pl-8">
        <p class="font-mono text-xs tracking-[0.18em] text-cyan-300">0{index + 1} / {system.status}</p>
        <h2 class="mt-5 text-5xl font-semibold tracking-[-0.05em] text-white md:text-6xl">{system.name}</h2>
        <p class="mt-3 text-sm text-slate-500">{system.category}</p>
        <p class="mt-8 max-w-xl text-xl leading-8 text-slate-200">{system.description}</p>
      </div>
      <div class="lg:pb-1">
        <p class="font-mono text-xs tracking-[0.15em] text-cyan-300">{system.focusLabel}</p>
        <p class="mt-3 text-base leading-7 text-slate-400">{system.focus}</p>
      </div>
    </div>
    <div class="nova-capabilities mt-10 grid gap-0 border-y border-cyan-300/15 sm:grid-cols-3">
      {system.systems.slice(0, 3).map((capability, capabilityIndex) => (
        <div class="border-b border-cyan-300/15 py-5 sm:border-b-0 sm:px-6 sm:first:pl-0 sm:[&:not(:last-child)]:border-r sm:[&:not(:last-child)]:border-cyan-300/15">
          <p class="font-mono text-xs text-cyan-300">0{capabilityIndex + 1}</p>
          <p class="mt-3 text-sm leading-6 text-slate-300">{capability}</p>
        </div>
      ))}
    </div>
  </section>
)}

{system.id === 'orion' && (
  <section id={system.id} class="core-profile core-orion mx-auto mt-24 max-w-6xl px-6 md:mt-28">
    <div class="orion-trajectory border-t border-dashed border-cyan-300/25 pt-8 lg:pt-12">
      <div class="grid gap-8 lg:grid-cols-[0.7fr_1.3fr]">
        <div>
          <p class="font-mono text-xs tracking-[0.18em] text-slate-400">0{index + 1} / {system.status}</p>
          <h2 class="mt-5 text-5xl font-semibold tracking-[-0.05em] text-white md:text-6xl">{system.name}</h2>
          <p class="mt-3 text-sm text-slate-500">{system.category}</p>
        </div>
        <div>
          <p class="max-w-xl text-xl leading-8 text-slate-200">{system.description}</p>
          <div class="mt-8 max-w-2xl border-l border-dashed border-cyan-300/40 pl-5">
            <p class="font-mono text-xs tracking-[0.15em] text-cyan-300">{system.focusLabel}</p>
            <p class="mt-3 text-base leading-7 text-slate-400">{system.focus}</p>
          </div>
        </div>
      </div>
      <ol class="mt-12 grid gap-5 md:grid-cols-3">
        {system.systems.slice(0, 3).map((capability, capabilityIndex) => (
          <li class="border-t border-cyan-300/15 pt-4">
            <p class="font-mono text-xs text-slate-500">PHASE 0{capabilityIndex + 1}</p>
            <p class="mt-3 text-sm leading-6 text-slate-300">{capability}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<style>
  .core-profile {
    position: relative;
    isolation: isolate;
  }

  .core-atlas::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: -2rem;
    right: 0;
    width: min(52%, 34rem);
    height: 18rem;
    opacity: 0.48;
    background-image:
      linear-gradient(rgba(0, 229, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 229, 255, 0.06) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, black, transparent 82%);
  }

  .core-atlas-frame {
    position: relative;
  }

  .atlas-capabilities p {
    min-height: 6.5rem;
  }

  .core-nova::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: -5rem;
    left: 18%;
    width: 30rem;
    height: 24rem;
    border-radius: 50%;
    opacity: 0.6;
    background: radial-gradient(ellipse, rgba(0, 229, 255, 0.1), rgba(37, 99, 235, 0.045) 40%, transparent 70%);
    filter: blur(30px);
  }

  .nova-study {
    position: relative;
  }

  .nova-capabilities {
    position: relative;
  }

  .core-orion::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: -7rem;
    right: 2%;
    width: 30rem;
    height: 19rem;
    border: 1px solid rgba(0, 229, 255, 0.08);
    border-radius: 50%;
    transform: rotate(-18deg);
  }

  .core-orion::after {
    content: "";
    position: absolute;
    z-index: -1;
    top: -3.25rem;
    right: 10%;
    width: 22rem;
    height: 13rem;
    border-top: 1px dashed rgba(0, 229, 255, 0.16);
    border-radius: 50%;
    transform: rotate(-18deg);
  }

  @media (max-width: 767px) {
    .core-atlas::before {
      width: 72%;
      height: 13rem;
    }

    .core-nova::before {
      left: -10rem;
    }

    .core-orion::before {
      right: -12rem;
    }
  }
</style>
