---
const {
  system
} = Astro.props;
---


<section class="mt-24 max-w-4xl mx-auto px-6">


<div class="border border-cyan-400/30 rounded-xl p-8 bg-black/40">


<div class="text-cyan-400 tracking-widest mb-6">

[ {system.name} CORE ]

</div>



<h2 class="text-3xl font-bold mb-2">

{system.category}

</h2>


<p class="text-gray-400 mb-8">

{system.description}

</p>



<div class="space-y-5 text-sm">


{
Object.entries(system.details).map(([key,value]) => (

<div>

<div class="text-cyan-400 uppercase tracking-widest">

{key}

</div>


<div class="text-gray-300 mt-2">

{
Array.isArray(value)
?
value.map(item => (
<div>
● {item}
</div>
))
:
value
}

</div>


</div>

))
}


</div>


</div>


</section>