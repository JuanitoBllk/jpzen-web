---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="JPZEN | Signal Lost"
  description="The requested path does not exist in the JPZEN laboratory."
  canonicalPath="/404/"
  robots="noindex,nofollow"
>
  <section id="top" class="mx-auto flex min-h-screen max-w-6xl items-center px-6 pb-20 pt-32 md:pt-40">
    <div class="max-w-2xl border-l border-cyan-300/45 pl-6 md:pl-8">
      <p class="font-mono text-xs tracking-[0.2em] text-cyan-300">JPZEN / ROUTE ERROR</p>
      <h1 class="mt-6 text-5xl font-semibold tracking-[-0.06em] text-white sm:text-6xl md:text-7xl">Signal Lost</h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">The requested path does not exist in this laboratory.</p>
      <a href="/" class="mt-10 inline-flex border border-cyan-300 px-6 py-3 font-mono text-xs tracking-[0.12em] text-cyan-300 transition hover:bg-cyan-300 hover:text-slate-950">RETURN HOME</a>
    </div>
  </section>
</Layout>
