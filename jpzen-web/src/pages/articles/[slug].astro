---
import ArticleSection from '../../components/ArticleSection.astro';
import { articles } from '../../data/articles.js';
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const coreRoutes = {
  ATLAS: '/atlas/',
  NOVA: '/nova/',
  ORION: '/orion/'
};
---

<Layout
  title={`JPZEN | ${article.title}`}
  description={article.summary}
  canonicalPath={article.route}
>
  <section id="top" class="mx-auto max-w-6xl px-6 pb-20 pt-32 md:pb-28 md:pt-40">
    <div class="grid gap-10 border-t border-cyan-300/15 pt-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end md:pt-10">
      <div>
        <p class="font-mono text-xs tracking-[0.2em] text-cyan-300">JPZEN / TECHNICAL ARTICLE</p>
        <h1 class="mt-6 max-w-3xl text-5xl font-semibold tracking-[-0.06em] text-white sm:text-6xl md:text-7xl">{article.title}</h1>
        <p class="mt-5 font-mono text-xs tracking-[0.14em] text-cyan-200">{article.relatedCore} / {article.category}</p>
        <p class="mt-8 max-w-2xl text-lg leading-8 text-slate-300">{article.summary}</p>
      </div>
      <div class="border-l border-cyan-300/40 pl-6 md:pl-8 lg:mb-2">
        <p class="font-mono text-xs tracking-[0.16em] text-slate-500">PUBLISHED</p>
        <p class="mt-3 font-mono text-sm tracking-[0.1em] text-cyan-300">{article.date}</p>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-6 pb-20 md:pb-28">
    <div class="max-w-3xl">
      {article.sections.map((section, index) => <ArticleSection section={section} index={index} />)}
    </div>

    <section class="mt-16 grid gap-8 border-t border-cyan-300/15 pt-8 md:grid-cols-[0.7fr_1.3fr] md:pt-10">
      <div>
        <p class="font-mono text-xs tracking-[0.18em] text-cyan-300">TECHNOLOGIES</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-0.04em] text-white md:text-4xl">Concepts in this article.</h2>
      </div>
      <ul class="grid gap-0 border-y border-cyan-300/15 sm:grid-cols-3">
        {article.technologies.map((technology, index) => (
          <li class="border-b border-cyan-300/15 py-5 sm:border-b-0 sm:px-6 sm:first:pl-0 sm:[&:not(:last-child)]:border-r sm:[&:not(:last-child)]:border-cyan-300/15">
            <p class="font-mono text-xs text-cyan-300">0{index + 1}</p>
            <p class="mt-3 text-sm text-slate-300">{technology}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-16 border-l border-cyan-300/45 pl-6 md:grid md:grid-cols-[0.7fr_1.3fr] md:gap-8 md:pl-8">
      <div>
        <p class="font-mono text-xs tracking-[0.18em] text-cyan-300">RELATED CORE</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-0.04em] text-white md:text-4xl">{article.relatedCore}</h2>
      </div>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 md:mt-0">This article belongs to the {article.relatedCore} engineering path within JPZEN.</p>
      <a href={coreRoutes[article.relatedCore]} class="mt-6 inline-flex font-mono text-xs tracking-[0.12em] text-cyan-300 transition hover:text-white md:col-start-2 md:mt-4">VIEW {article.relatedCore} CORE</a>
    </section>
  </div>
</Layout>
