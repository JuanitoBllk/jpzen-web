---
import CorePageHero from '../components/CorePageHero.astro';
import SystemCard from '../components/SystemCard.astro';
import { nova } from '../data/nova.js';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="NOVA | JPZEN"
  description="NOVA is the AI and automation experimentation core of the JPZEN personal technology laboratory."
  canonicalPath="/nova"
>
  <CorePageHero core={nova} />

  <section class="mx-auto mt-24 max-w-6xl px-6 md:mt-32">
    <div class="grid gap-8 border-t border-cyan-300/15 pt-8 md:grid-cols-[0.7fr_1.3fr] md:pt-10">
      <div>
        <p class="font-mono text-xs tracking-[0.18em] text-cyan-300">CAPABILITIES</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-0.04em] text-white md:text-4xl">Exploration through applied systems.</h2>
      </div>
      <p class="max-w-2xl text-base leading-7 text-slate-400">NOVA documents capability areas and research directions, not private services or operational interfaces.</p>
    </div>

    <div class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {nova.capabilities.map((capability, index) => <SystemCard system={capability} index={index} />)}
    </div>
  </section>

  <section class="mx-auto mt-24 max-w-6xl px-6 md:mt-32">
    <div class="border-l border-cyan-300/45 pl-6 md:grid md:grid-cols-[0.7fr_1.3fr] md:gap-8 md:pl-8">
      <div>
        <p class="font-mono text-xs tracking-[0.18em] text-cyan-300">CURRENT FOCUS</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-0.04em] text-white md:text-4xl">Useful experiments, tested deliberately.</h2>
      </div>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 md:mt-0">NOVA explores AI-assisted workflows, agents, and automation experiments through small, testable iterations that can inform future practical systems.</p>
    </div>
  </section>

  <section class="mx-auto mt-24 max-w-6xl px-6 pb-20 md:mt-32 md:pb-28">
    <div class="border-t border-cyan-300/15 pt-8 md:grid md:grid-cols-[0.7fr_1.3fr] md:gap-8 md:pt-10">
      <div>
        <p class="font-mono text-xs tracking-[0.18em] text-cyan-300">PHILOSOPHY</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-0.04em] text-white md:text-4xl">Ideas become systems through iteration.</h2>
      </div>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 md:mt-0">NOVA is the experimentation layer where ideas become practical systems through testing, observation, and iteration. It values useful learning over claims of finished automation.</p>
    </div>
  </section>
</Layout>
