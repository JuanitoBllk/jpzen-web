---
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';
import DocumentationSection from '../../components/DocumentationSection.astro';
import { diagrams } from '../../data/diagrams.js';
import Layout from '../../layouts/Layout.astro';
import ProjectPageHero from '../../components/ProjectPageHero.astro';
import { projects } from '../../data/projects.js';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const diagram = diagrams.find((item) => item.id === project.diagram);
---

<Layout
  title={`JPZEN | ${project.title}`}
  description={project.description}
  canonicalPath={project.route}
>
  <ProjectPageHero project={project} />

  <div class="pb-20 md:pb-28">
    <DocumentationSection label="OVERVIEW" title="Engineering context." content={project.description} />
    {diagram && <ArchitectureDiagram diagram={diagram} />}
    <DocumentationSection label="OBJECTIVE" title="What this record explores." content={project.objective} />
    <DocumentationSection label="ENGINEERING APPROACH" title="Learning through deliberate practice." content={project.approach} />
    <DocumentationSection label="TECHNOLOGIES" title="Public project vocabulary." items={project.technologies} />
    <DocumentationSection label="LESSONS LEARNED" title="Knowledge captured through iteration." content={project.lessons} />
    <DocumentationSection label="ENGINEERING PHILOSOPHY" title="Documented through practice." content={project.philosophy} />
    <DocumentationSection label="FUTURE EVOLUTION" title="Next areas of exploration." content={project.future} />
  </div>
</Layout>
