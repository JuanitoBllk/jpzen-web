---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects.js';

const categories = ['Infrastructure', 'Artificial Intelligence', 'Networking'];
---

<Layout
  title="JPZEN | Project Documentation"
  description="Public documentation for JPZEN engineering experiments and technology projects."
  canonicalPath="/projects/"
>
  <section id="top" class="mx-auto max-w-6xl px-6 pb-20 pt-32 md:pb-28 md:pt-40">
    <div class="grid gap-8 border-t border-cyan-300/15 pt-8 md:grid-cols-[0.7fr_1.3fr] md:pt-10">
      <div>
        <p class="font-mono text-xs tracking-[0.18em] text-cyan-300">PROJECT DOCUMENTATION</p>
        <h1 class="mt-4 text-5xl font-semibold tracking-[-0.05em] text-white md:text-6xl">Engineering archive.</h1>
      </div>
      <p class="max-w-2xl text-base leading-7 text-slate-400">Documented experiments, systems and engineering paths developed inside JPZEN. Entries document purpose and learning without exposing private infrastructure.</p>
    </div>

    <div class="mt-14 space-y-16">
      {categories.map((category) => {
        const categoryProjects = projects.filter((project) => project.category === category);

        return (
          <section>
            <div class="flex items-center justify-between border-b border-cyan-300/15 pb-4">
              <h2 class="text-xl font-semibold tracking-[-0.02em] text-white">{category}</h2>
              <p class="font-mono text-xs tracking-[0.12em] text-slate-500">{categoryProjects.length.toString().padStart(2, '0')} RECORDS</p>
            </div>
            <div class="mt-8 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
              {categoryProjects.map((project, index) => <ProjectCard project={project} index={index} />)}
            </div>
          </section>
        );
      })}
    </div>
  </section>
</Layout>
